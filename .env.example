# Public values exposed to the browser must use the VITE_ prefix.
VITE_APP_ENV=development
VITE_PUBLIC_APP_URL=http://localhost:5173
VITE_API_BASE_URL=
VITE_HEALTHCHECK_URL=/health.json
VITE_ENABLE_ANALYTICS=false

# Never put private keys, database credentials, or server secrets in VITE_ variables.
# Add server-only secrets in the Vercel project Environment Variables UI instead.
